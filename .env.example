# ===================================================================
# VoteUASZ - Variables d'environnement pour déploiement et exécution
# ===================================================================

# Configuration Générale de l'Environnement
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:4200

# Base de Données PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=voteuasz_db
POSTGRES_USER=voteuasz_user
POSTGRES_PASSWORD=voteuasz_secret_password_change_me
POSTGRES_SSL_MODE=disable

# Sécurité & Authentification JWT
# Le secret doit être une chaîne aléatoire d'au moins 256 bits (32 caractères)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000          # 15 minutes pour le token d'accès
JWT_REFRESH_EXPIRATION_MS=86400000 # 24 heures pour le token de rafraîchissement

# Initialisation Sécurisée du Premier Administrateur
INITIAL_ADMIN_EMAIL=admin.electoral@uasz.sn
INITIAL_ADMIN_PASSWORD=AdminUasz2026!ChangeM3Immediately
INITIAL_ADMIN_NOM=Super Admin
INITIAL_ADMIN_PRENOM=Commission UASZ

# OTP (Email / SMS)
# En profil "dev", un MockOtpService simule l'envoi et journalise en toute sécurité sans exposer le code
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_PROVIDER=mock
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=elections@uasz.sn
MAIL_PASSWORD=change_me
MAIL_FROM=elections@uasz.sn

# Stockage et Téléversements (Candidatures, Justificatifs)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080,https://voteuasz.vercel.app
