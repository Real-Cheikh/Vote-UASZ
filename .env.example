# ==============================================================================
# VoteUASZ - Modèle de Variables d'Environnement pour Déploiement Cloud & Local
# IMPORTANT : Ne commitez JAMAIS de vrais secrets dans ce fichier ou sur GitHub.
# Renseignez ces variables directement dans les interfaces sécurisées (Render, Supabase, Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Supabase Cloud / Local)
# ------------------------------------------------------------------------------
# Option A : URL JDBC complète (Recommandée pour Supabase Session Pooler)
# À récupérer dans le dashboard Supabase : Project Settings > Database > Connection string > Tab "JDBC"
# Mode Session Pooler (port 5432) requis pour supporter les migrations Flyway et les verrous DDL.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.voteprojectref
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe_supabase_securise

# Option B : Paramètres décomposés (Alternative si URL directe)
POSTGRES_HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.voteprojectref
POSTGRES_PASSWORD=votre_mot_de_passe_supabase_securise
POSTGRES_SSL_MODE=require

# Configuration du pool HikariCP (Optimisé pour Supabase Free / Pro Tier)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 2. CONFIGURATION DU BACKEND SPRING BOOT (Render Web Service)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Le port d'écoute est automatiquement injecté par Render via la variable $PORT
PORT=10000
SERVER_PORT=8080

# Sécurité & Authentification JWT (Générer une clé aléatoire SHA-256 de 64 caractères hexadécimaux)
# Exemple de génération : openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000          # 15 minutes (token d'accès)
JWT_REFRESH_EXPIRATION_MS=86400000 # 24 heures (token de rafraîchissement)

# Compte Super Administrateur Initial (Bootstrap au premier démarrage)
INITIAL_ADMIN_EMAIL=admin.electoral@uasz.sn
INITIAL_ADMIN_PASSWORD=SuperAdminUasz2026!Securise
INITIAL_ADMIN_NOM=Super Admin
INITIAL_ADMIN_PRENOM=Commission UASZ

# OTP Sécurité (Validité 5 minutes, 3 tentatives maximum)
OTP_EXPIRATION_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_PROVIDER=mock

# Stockage des fichiers (Candidatures & Justificatifs)
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 3. CORS & CONNEXIONS FRONTEND / BACKEND (Render <-> Vercel)
# ------------------------------------------------------------------------------
# Liste des origines autorisées sans joker universel '*' (séparation par virgules)
# Incluez votre domaine de production Vercel, les previews, et l'environnement local
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://*.vercel.app,https://vote-uasz.vercel.app

# ------------------------------------------------------------------------------
# 4. FRONTEND ANGULAR (Vercel)
# ------------------------------------------------------------------------------
# URL publique HTTPS du backend déployé sur Render (utilisée pour configurer environment.prod.ts)
BACKEND_PUBLIC_URL=https://voteuasz-backend.onrender.com
